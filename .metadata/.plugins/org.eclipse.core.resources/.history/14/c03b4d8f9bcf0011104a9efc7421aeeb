server:
  port: 8765

spring:
  application:
    name: API-GATEWAY
  cloud:
    gateway:
      server:
        webflux:
          routes:
            - id: account-service
              uri: lb://account-service
              predicates:
                - Path=/api/v1/accounts,/api/v1/accounts/**

            - id: customer-service
              uri: lb://customer-service
              predicates:
                - Path=/api/v1/customers,/api/v1/customers/**

eureka:
  client:
    service-url:
      defaultZone: http://eurekaservercontainer:8761/eureka/
    register-with-eureka: true
    fetch-registry: true