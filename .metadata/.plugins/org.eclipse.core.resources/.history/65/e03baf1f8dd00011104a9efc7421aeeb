server:
  port: 8765

spring:
  application:
    name: API-GATEWAY

  cloud:
    gateway:
      server:
        webflux:
					default-filters:
					- RemoveRequestHeader=Origin
          routes:
            - id: auth-service
              uri: lb://AUTHENTICATION-SERVICE
              predicates:
                - Path=/auth/**

            - id: account-service
              uri: lb://ACCOUNT-SERVICE
              predicates:
                - Path=/api/v1/accounts/**

            - id: customer-service
              uri: lb://CUSTOMER-SERVICE
              predicates:
                - Path=/api/v1/customers/**

eureka:
  client:
    service-url:
      defaultZone: http://eureka-service:8761/eureka/
    register-with-eureka: true
    fetch-registry: true